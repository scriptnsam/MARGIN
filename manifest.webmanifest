{
  "name": "Margin: learn something every day",
  "short_name": "Margin",
  "description": "A reading app for broad general knowledge. Read fresh articles from Wikipedia or short curated lessons, search any topic, save pages and set gentle daily reminders.",
  "id": "./index.html",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#f4f5f7",
  "theme_color": "#0f5c4d",
  "categories": [
    "education",
    "books",
    "reference"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Read something new",
      "short_name": "Read",
      "description": "Open a fresh page to read",
      "url": "./index.html#read",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search any topic",
      "url": "./index.html#search",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Learn a language",
      "short_name": "Languages",
      "description": "Mandarin and Korean lessons",
      "url": "./index.html#lang",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Saved pages",
      "short_name": "Saved",
      "description": "Pages you saved for later",
      "url": "./index.html#saved",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}